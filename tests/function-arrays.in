array a[4];
a[0] = 'A';
a[1] = 'B';
a[2] = 'C';
a[3] = 'D';

fun modify(arr) {
    print arr;
    print arr[0];
    print arr[1];
    print arr[2];
    print arr[3];
    arr[0] = 'E';
}

// Should not return an array, only the first element
fun returnArr(fourthEl) {
    array ret[5];
    ret[3] = fourthEl;
    ret[0] = 'F';
    returns ret;
}
modify(a);
print a[0];
print(returnArr(4));